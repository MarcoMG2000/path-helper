{
  "name": "path-helper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Mini-app web/móvil para una campaña de Pathfinder 1e (Core Rulebook)",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "data:import": "tsx scripts/srd/cli.ts import",
    "data:parse": "tsx scripts/srd/cli.ts parse",
    "data:glossary": "tsx scripts/srd/cli.ts glossary",
    "data:validate": "tsx scripts/srd/cli.ts validate",
    "data:sample": "tsx scripts/srd/cli.ts sample",
    "create-gm": "tsx src/server/cli/create-gm.ts",
    "reset-gm-lock": "tsx src/server/cli/reset-gm-lock.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "fastify": "5.12.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "cheerio": "1.2.0",
    "concurrently": "10.0.6",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  }
}
