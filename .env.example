# Copia este fichero a .env y ajusta los valores (.env no se versiona).
# Las variables del entorno del proceso tienen prioridad sobre este fichero.

# development | test | production
NODE_ENV=development

# Interfaz de escucha de la API y del servidor de desarrollo de Vite.
# Para probar desde el móvil en la red local, usa HOST=0.0.0.0
HOST=127.0.0.1

# Puerto de la API (0 = puerto efímero, útil en tests)
PORT=3000

# Puerto del servidor de desarrollo de Vite (si está ocupado, falla)
WEB_PORT=5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Base de datos (SQLite) ---

# Fichero de la base de datos (se crea, junto a su directorio, si no existe)
DATABASE_PATH=./data/path-helper.sqlite

# --- Autenticación (f1-auth-roles) ---

# SECRETO: pepper del hash de PIN (mínimo 32 caracteres). SUSTITUYE este marcador por un valor
# aleatorio propio, p. ej.: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Si lo cambias, todos los PIN existentes dejan de ser válidos (hay que restablecerlos).
AUTH_PEPPER=change-me-this-is-not-a-secret-change-me

# Cookie de sesión con atributo Secure. En desarrollo local (http) debe ser false.
AUTH_COOKIE_SECURE=false

# Orígenes permitidos para peticiones mutantes (protección CSRF), separados por comas.
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Caducidad de sesión por inactividad / absoluta, en días
AUTH_SESSION_IDLE_DAYS=7
AUTH_SESSION_ABSOLUTE_DAYS=30

# Bloqueo por intentos de login fallidos: fallos consecutivos, minutos del primer bloqueo
# (se duplica en cada bloqueo sucesivo) y tope en horas
AUTH_LOCK_MAX_FAILURES=5
AUTH_LOCK_BASE_MINUTES=15
AUTH_LOCK_MAX_HOURS=24
